{
  "name": "healthy_meal_rn",
  "version": "1.0.0",
  "description": "An Expo React Native app that surfaces a deterministic daily healthy meal based on saved dietary preferences.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "lint": "eslint . --max-warnings 0",
    "check:expo": "npx expo install --check",
    "check": "npm run lint && npm run check:expo && npm test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "57.0.29",
    "expo-asset": "~57.0.20",
    "expo-image": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^15.1.3",
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3"
  },
  "private": true
}
